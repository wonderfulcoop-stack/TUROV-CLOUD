<!doctype html>
<html lang="ru">
<%- include('head',{title}) %>
<body class="public-download-body"><div id="tcPreloader" class="tc-preloader" aria-hidden="true"><div class="tc-preloader-mark"><span class="tc-preloader-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.parentElement.classList.add('fallback')"></span><span class="tc-preloader-name">Turov Cloud</span></div></div>
  <header class="public-download-nav">
    <a class="brand public-brand brand-with-asset" href="/"><img src="/assets/logo.png" alt="Turov Cloud" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-grid'"><span class="asset-fallback"><span class="logoMark"></span></span><span>Turov Cloud</span></a>
    <nav>
      <a href="/">Главная</a>
      <a href="/dashboard">Файлы</a>
      <% if(user){ %>
        <a class="nav-user-pill" href="/dashboard"><span><%= (user.name||'U').slice(0,1).toLowerCase() %></span><b><%= user.name %></b></a>
      <% } else { %>
        <a href="/login">Войти</a>
      <% } %>
    </nav>
  </header>

  <main class="public-download-main">
    <section class="download-card pro-appear">
      <div class="download-anim-wrap">
        <img class="download-gif" src="/assets/download.gif" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'">
        <div class="download-fallback-icon" style="display:none">
          <svg viewBox="0 0 24 24" fill="none"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" stroke="currentColor" stroke-width="2"/><path d="M14 3v5h5M12 12v5m0 0 2-2m-2 2-2-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>

      <div class="file-title-row">
        <span class="file-mini-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" stroke="currentColor" stroke-width="2"/><path d="M14 3v5h5" stroke="currentColor" stroke-width="2"/></svg></span>
        <h1><%= f.original_name %></h1>
      </div>

      <div class="download-meta">
        <span><svg viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><%= fmt(f.size) %></span>
        <span><svg viewBox="0 0 24 24" fill="none"><path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><%= f.downloads %> скачиваний</span>
        <span><svg viewBox="0 0 24 24" fill="none"><path d="M12 8v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Удалится через 1 час</span>
      </div>

      <% if(locked){ %>
        <div class="file-password-card">
          <h2>🔒 Файл защищён паролем</h2>
          <p>Это приватный файл. Открыть его может только владелец аккаунта, а для скачивания нужен дополнительный пароль.</p>
          <% if(error){ %><p class="file-password-error"><%= error %></p><% } %>
          <form method="post" action="/file/<%= f.slug || f.id %>/unlock">
            <input name="password" type="password" placeholder="Введите пароль" autocomplete="current-password" required autofocus>
            <button type="submit">Открыть файл</button>
          </form>
        </div>
      <% } else { %>
      <a class="download-main-btn" href="/download/<%= f.id %>" onclick="revealVpnBanner()">
        <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Скачать
      </a>
      <% } %>

      <div class="vpn-download-banner vpn-image-only" id="vpnBanner" aria-live="polite">
        <a class="vpn-image-link" href="<%= vpnUrl %>" target="_blank" rel="noopener">
          <span class="vpn-image-glow"></span>
          <img class="vpn-banner-media-full" src="/assets/vpn-banner.gif" alt="Turov VPN" onerror="swapVpnBannerAsset(this)">
          <span class="vpn-banner-fallback vpn-wide-fallback">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 20 6v5c0 5-3.4 8.7-8 10-4.6-1.3-8-5-8-10V6l8-3Z" stroke="currentColor" stroke-width="2"/><path d="M9 12l2 2 4-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <b>Включил VPN — ускорил скачивание</b>
          </span>
          <span class="vpn-connect-btn">Подключить</span>
        </a>
      </div>
    </section>
  </main>
  <script>
    function revealVpnBanner(){
      setTimeout(function(){
        const banner=document.getElementById('vpnBanner');
        if(banner) banner.classList.add('show');
      },160);
    }
    function swapVpnBannerAsset(img){
      if(!img.dataset.triedPng){
        img.dataset.triedPng='1';
        img.src='/assets/vpn-banner.png';
        return;
      }
      img.style.display='none';
      const fallback=img.parentElement && img.parentElement.querySelector('.vpn-banner-fallback');
      if(fallback) fallback.style.display='grid';
    }
  </script>
<script>(function(){var loader=document.getElementById('tcPreloader');if(!loader)return;var started=Date.now();var min=850;function hide(){var wait=Math.max(0,min-(Date.now()-started));setTimeout(function(){loader.classList.add('tc-preloader-hide');setTimeout(function(){if(loader&&loader.parentNode)loader.parentNode.removeChild(loader)},620)},wait)}if(document.readyState==='complete'){hide()}else{window.addEventListener('load',hide,{once:true});setTimeout(hide,2600)}})();</script></body>
</html>
