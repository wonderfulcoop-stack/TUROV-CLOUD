<!doctype html><html lang="ru"><%- include('head',{title}) %><body class="auth"><div id="tcPreloader" class="tc-preloader" aria-hidden="true"><div class="tc-preloader-mark"><span class="tc-preloader-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.parentElement.classList.add('fallback')"></span><span class="tc-preloader-name">Turov Cloud</span></div></div><div class="panel"><h1>Файл недоступен</h1><p>Он был удалён или срок хранения закончился.</p><a class="btn full" href="/">На главную</a></div><script>(function(){var loader=document.getElementById('tcPreloader');if(!loader)return;var started=Date.now();var min=850;function hide(){var wait=Math.max(0,min-(Date.now()-started));setTimeout(function(){loader.classList.add('tc-preloader-hide');setTimeout(function(){if(loader&&loader.parentNode)loader.parentNode.removeChild(loader)},620)},wait)}if(document.readyState==='complete'){hide()}else{window.addEventListener('load',hide,{once:true});setTimeout(hide,2600)}})();</script></body></html>
