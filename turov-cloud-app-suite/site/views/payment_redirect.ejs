<!DOCTYPE html>
<html lang="ru">
<head>
<link rel="icon" type="image/png" href="/assets/logo.png">
<link rel="shortcut icon" href="/assets/logo.png">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title || 'Оплата Premium' %></title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  min-height:100vh;
  background:
    radial-gradient(circle at 80% 85%,rgba(55,105,255,.24),transparent 34%),
    radial-gradient(circle at 20% 15%,rgba(120,80,255,.16),transparent 30%),
    #151519;
  color:#fff;
  font-family:Inter,Arial,sans-serif;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
}

.card{
  width:100%;
  max-width:470px;
  background:linear-gradient(180deg,#101014,#09090b);
  border:1px solid rgba(255,255,255,.09);
  border-radius:32px;
  padding:34px;
  box-shadow:
    0 34px 90px rgba(0,0,0,.55),
    0 0 45px rgba(92,92,255,.08),
    inset 0 1px 0 rgba(255,255,255,.04);
  animation:fadeIn .55s ease;
}

@keyframes fadeIn{
  from{opacity:0;transform:translateY(18px) scale(.98)}
  to{opacity:1;transform:translateY(0) scale(1)}
}

.brand{
  text-align:center;
  font-size:22px;
  font-weight:950;
  margin-bottom:24px;
  letter-spacing:-.4px;
}

.icon{
  width:60px;
  height:60px;
  border-radius:21px;
  background:linear-gradient(135deg,#5d8cff,#784cff);
  display:flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 18px;
  font-size:28px;
  box-shadow:
    0 0 26px rgba(102,95,255,.52),
    0 16px 38px rgba(89,86,255,.28);
  animation:pulseGlow 2.7s ease-in-out infinite;
}

@keyframes pulseGlow{
  0%,100%{box-shadow:0 0 22px rgba(102,95,255,.42),0 16px 38px rgba(89,86,255,.24)}
  50%{box-shadow:0 0 36px rgba(102,95,255,.72),0 18px 45px rgba(89,86,255,.35)}
}

h1{
  text-align:center;
  margin:0;
  font-size:30px;
  line-height:1.1;
  letter-spacing:-.8px;
}

.sub{
  text-align:center;
  color:#aaaeba;
  margin-top:9px;
  font-size:16px;
}

.price{
  margin:26px 0 24px;
  padding:22px;
  border-radius:22px;
  background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.035));
  border:1px solid rgba(255,255,255,.09);
  display:flex;
  justify-content:space-between;
  align-items:center;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.04),
    0 14px 34px rgba(0,0,0,.28);
}

.sum{
  font-size:40px;
  font-weight:950;
  letter-spacing:-1px;
}

.days{
  color:#d4d5df;
  font-weight:850;
  font-size:15px;
}

.btn{
  width:100%;
  display:block;
  text-align:center;
  text-decoration:none;
  border-radius:20px;
  padding:18px;
  font-size:20px;
  font-weight:950;
  cursor:pointer;
  position:relative;
  transition:.22s ease;
  overflow:hidden;
}

.pay{
  background:linear-gradient(135deg,#fff,#e3e3e8);
  color:#111;
  border:1px solid rgba(255,255,255,.45);
  box-shadow:
    0 0 0 1px rgba(120,100,255,.18),
    0 14px 34px rgba(255,255,255,.16),
    inset 0 1px 0 rgba(255,255,255,.75);
}

.pay:hover{
  transform:translateY(-3px) scale(1.01);
  box-shadow:
    0 18px 46px rgba(255,255,255,.22),
    0 0 28px rgba(118,86,255,.38),
    inset 0 1px 0 rgba(255,255,255,.8);
}

.paid{
  margin-top:13px;
  background:linear-gradient(180deg,#202025,#151519);
  color:#fff;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:
    0 12px 26px rgba(0,0,0,.38),
    inset 0 1px 0 rgba(255,255,255,.06);
}

.paid:hover{
  transform:translateY(-2px);
  background:linear-gradient(180deg,#27272e,#17171c);
  box-shadow:
    0 16px 34px rgba(0,0,0,.45),
    0 0 20px rgba(114,86,255,.22),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.order{
  margin-top:15px;
  text-align:center;
  color:#aeb0bd;
  font-size:13px;
  word-break:break-all;
}

.order b{color:#fff}

.notice{
  margin-bottom:16px;
  text-align:center;
  color:#dfffea;
  font-size:14px;
  line-height:1.45;
  padding:13px;
  border-radius:16px;
  background:rgba(65,255,150,.10);
  border:1px solid rgba(65,255,150,.18);
}

.support{
  margin-top:12px;
  text-align:center;
  color:#8f93a3;
  font-size:13px;
}

.support a{
  color:#fff;
  text-decoration:none;
  font-weight:900;
}

.back{
  display:block;
  margin-top:24px;
  text-align:center;
  color:#cfd0dc;
  text-decoration:none;
  font-weight:850;
  transition:.2s;
}

.back:hover{
  color:#fff;
  text-shadow:0 0 14px rgba(255,255,255,.35);
}
</style>
</head>

<body><div id="tcPreloader" class="tc-preloader" aria-hidden="true"><div class="tc-preloader-mark"><span class="tc-preloader-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.parentElement.classList.add('fallback')"></span><span class="tc-preloader-name">Turov Cloud</span></div></div>
<div class="card">
  <div class="brand">Turov Cloud</div>

  <div class="icon">✦</div>

  <h1>Оплата Premium</h1>
  <div class="sub"><%= cfg.title %></div>

  <div class="price">
    <div class="sum"><%= cfg.amount %> ₽</div>
    <div class="days"><%= cfg.days %> дней</div>
  </div>

  <% if (typeof sent !== 'undefined' && sent) { %>
    <div class="notice">
      Заявка отправлена ✅<br>
      Администратор проверит перевод и активирует Premium.
    </div>
  <% } %>

  <a class="btn pay" href="<%= payURL %>" target="_blank" rel="noopener">
    Оплатить
  </a>

  <form method="POST" action="/premium/pay/<%= label %>/confirm">
    <button class="btn paid" type="submit">Я оплатил</button>
  </form>

  <div class="order">
    Заказ: <b><%= label %></b>
  </div>

  <div class="support">
    Проблемы с оплатой? <a href="https://t.me/brawlbuisness" target="_blank">@brawlbuisness</a>
  </div>

  <a class="back" href="/dashboard">Назад</a>
</div>
<script>(function(){var loader=document.getElementById('tcPreloader');if(!loader)return;var started=Date.now();var min=850;function hide(){var wait=Math.max(0,min-(Date.now()-started));setTimeout(function(){loader.classList.add('tc-preloader-hide');setTimeout(function(){if(loader&&loader.parentNode)loader.parentNode.removeChild(loader)},620)},wait)}if(document.readyState==='complete'){hide()}else{window.addEventListener('load',hide,{once:true});setTimeout(hide,2600)}})();</script></body>
</html>