<!doctype html>
<html lang="ru">
<%- include('head',{title}) %>
<body class="auth auth-pro"><div id="tcPreloader" class="tc-preloader" aria-hidden="true"><div class="tc-preloader-mark"><span class="tc-preloader-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.parentElement.classList.add('fallback')"></span><span class="tc-preloader-name">Turov Cloud</span></div></div>
  <a class="auth-logo brand-with-asset" href="/">
    <img src="/assets/logo.png" alt="Turov Cloud" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-grid'">
    <span class="asset-fallback"><span class="logoMark"></span></span>
    <b>Turov Cloud</b>
  </a>

  <% const isLogin = mode==='login'; const isRegister = mode==='register'; const isForgot = mode==='forgot'; const isForgotDone = mode==='forgot_done'; const isReset = mode==='reset'; const isExpired = mode==='reset_expired'; %>
  <form class="auth-card pro-appear" method="post" action="<%= isLogin?'/login':isRegister?'/register':isForgot?'/forgot':isReset?('/reset/'+token):'/login' %>">
    <h1><%= isLogin?'С возвращением':isRegister?'Создать аккаунт':isForgot?'Восстановление пароля':isForgotDone?'Проверьте ссылку':isReset?'Новый пароль':'Ссылка истекла' %></h1>
    <p><%= isLogin?'Войдите в аккаунт Turov Cloud':isRegister?'Зарегистрируйтесь для загрузки файлов':isForgot?'Введите почту аккаунта — мы создадим ссылку для смены пароля':isForgotDone?'Для тестовой версии ссылка показана ниже и также выведена в консоль сервера.':isReset?'Придумайте новый пароль для аккаунта':'Запросите новую ссылку восстановления.' %></p>

    <% if(isLogin){ %>
      <button class="bio-login" type="button" onclick="loginPasskey(this)">
        <svg viewBox="0 0 24 24" fill="none"><path d="M12 11v2m-4 8v-5a4 4 0 0 1 8 0v5M7 9a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M5 11a7 7 0 0 1 14 0v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Войти по лицу или отпечатку
      </button>
    <% } %>

    <% if(flash){ %><div class="flash auth-flash"><%= flash %></div><% } %>

    <% if(isRegister){ %>
      <input name="name" placeholder="Введите имя" autocomplete="name" required>
      <input name="email" type="email" placeholder="Введите логин или почту" autocomplete="email" required>
      <div class="password-wrap"><input name="password" type="password" placeholder="Введите пароль" autocomplete="new-password" required><span>◉</span></div>
    <% } else if(isLogin){ %>
      <input name="email" type="email" placeholder="Введите логин или почту" autocomplete="email" required>
      <div class="password-wrap"><input name="password" type="password" placeholder="Введите пароль" autocomplete="current-password" required><span>◉</span></div>
      <a class="forgot-link" href="/forgot">Забыли пароль?</a>
      <div class="captcha-stub" id="captchaStub"><span></span><b id="captchaText">Идёт проверка...</b><em>SECURE</em></div>
    <% } else if(isForgot){ %>
      <input name="email" type="email" placeholder="Введите почту аккаунта" autocomplete="email" required>
    <% } else if(isForgotDone){ %>
      <div class="reset-info">
        <% if(resetLink){ %>
          <small>Тестовая ссылка восстановления:</small>
          <input readonly value="<%= resetLink %>" onclick="this.select();navigator.clipboard.writeText(this.value)">
          <a class="reset-link-btn" href="<%= resetLink %>">Открыть восстановление</a>
        <% } else { %>
          <b>Если аккаунт существует, ссылка восстановления создана.</b>
          <small>Это сделано специально, чтобы никто не мог проверить, зарегистрирована ли почта.</small>
        <% } %>
      </div>
    <% } else if(isReset){ %>
      <div class="password-wrap"><input name="password" type="password" placeholder="Введите новый пароль" autocomplete="new-password" required minlength="6"><span>◉</span></div>
    <% } else if(isExpired){ %>
      <div class="reset-info"><b>Ссылка недействительна или уже использована.</b><small>Создайте новую ссылку восстановления.</small></div>
    <% } %>

    <% if(isForgotDone || isExpired){ %>
      <a class="auth-submit link-submit" href="/forgot">Создать новую ссылку</a>
    <% } else { %>
      <button class="auth-submit" type="submit"><%= isLogin?'Войти':isRegister?'Зарегистрироваться':isForgot?'Получить ссылку':isReset?'Сохранить пароль':'Продолжить' %></button>
    <% } %>

    <div class="auth-switch">
      <% if(isLogin){ %>Нет аккаунта? <a href="/register">Зарегистрироваться</a><% } %>
      <% if(isRegister){ %>Уже есть аккаунт? <a href="/login">Войти</a><% } %>
      <% if(isForgot || isForgotDone || isReset || isExpired){ %><a href="/login">Вернуться ко входу</a><% } %>
    </div>
  </form>

  <p class="auth-terms">Продолжая, вы соглашаетесь с нашими <a href="#">условиями использования</a>, <a href="#">политикой конфиденциальности</a><br>и правилами обработки персональных данных.</p>
  <% if(mode==='login'){ %><script>
setTimeout(()=>{const c=document.getElementById('captchaStub');const t=document.getElementById('captchaText');if(c&&t){c.classList.add('done');t.textContent='Проверка пройдена';}},900);
function b64urlToBuf(v){const pad='='.repeat((4-v.length%4)%4);const s=(v+pad).replace(/-/g,'+').replace(/_/g,'/');const bin=atob(s);const buf=new ArrayBuffer(bin.length);const bytes=new Uint8Array(buf);for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);return buf}
function bufToB64url(buf){const bytes=new Uint8Array(buf);let bin='';bytes.forEach(b=>bin+=String.fromCharCode(b));return btoa(bin).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function prepAuthOptions(o){o.challenge=b64urlToBuf(o.challenge);if(o.allowCredentials)o.allowCredentials=o.allowCredentials.map(c=>({...c,id:b64urlToBuf(c.id)}));return o}
function packAuthCredential(c){return {id:c.id,rawId:bufToB64url(c.rawId),type:c.type,response:{authenticatorData:bufToB64url(c.response.authenticatorData),clientDataJSON:bufToB64url(c.response.clientDataJSON),signature:bufToB64url(c.response.signature),userHandle:c.response.userHandle?bufToB64url(c.response.userHandle):null}}}
async function loginPasskey(btn){try{if(!window.PublicKeyCredential)throw new Error('passkeys_not_supported');btn.classList.add('loading');const opt=await fetch('/passkey/login/options',{method:'POST'}).then(r=>r.json());const cred=await navigator.credentials.get({publicKey:prepAuthOptions(opt)});const result=await fetch('/passkey/login/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(packAuthCredential(cred))}).then(r=>r.json());if(result.ok){location.href='/dashboard'}else{alert('Passkey не найден. Сначала привяжи его в профиле.')}}catch(e){alert('На этом устройстве быстрый вход недоступен или passkey ещё не привязан.')}finally{btn.classList.remove('loading')}}
</script><% } %>
<script>(function(){var loader=document.getElementById('tcPreloader');if(!loader)return;var started=Date.now();var min=850;function hide(){var wait=Math.max(0,min-(Date.now()-started));setTimeout(function(){loader.classList.add('tc-preloader-hide');setTimeout(function(){if(loader&&loader.parentNode)loader.parentNode.removeChild(loader)},620)},wait)}if(document.readyState==='complete'){hide()}else{window.addEventListener('load',hide,{once:true});setTimeout(hide,2600)}})();</script></body>
</html>
