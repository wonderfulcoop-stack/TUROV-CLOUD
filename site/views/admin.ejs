<!doctype html><html lang="ru"><%- include('head',{title}) %><body class="app"><script>try{if(sessionStorage.getItem('tc_splash_seen')==='1')document.documentElement.classList.add('tc-splash-seen')}catch(e){}</script><div id="tcPreloader" class="tc-preloader" aria-hidden="true"><div class="tc-preloader-mark"><span class="tc-preloader-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.parentElement.classList.add('fallback')"></span><span class="tc-preloader-name">Turov Cloud</span></div></div><aside><a class="brand" href="/"><span class="logo">◰</span>Turov Cloud</a><a href="/dashboard">← Дашборд</a><a class="active" href="/admin">⚙ Админ-панель</a></aside><main class="dash"><div class="dashbar">Админ-панель</div><section class="stats"><div><span>Всего файлов</span><b><%= stats.files %></b></div><div><span>Занято</span><b><%= fmt(stats.size) %></b></div><div><span>Скачивания</span><b><%= stats.downloads %></b></div><div><span>Пользователи</span><b><%= users.length %></b></div></section>

<section class="filebox admin-support" id="support-chat">
  <h2>Чат поддержки</h2>
  <div class="admin-chat-layout">
    <div class="admin-chat-users">
      <% if(!(chatUsers||[]).length){ %><div class="admin-chat-empty">Пока нет обращений</div><% } %>
      <% (chatUsers||[]).forEach(c=>{ %>
        <a class="admin-chat-user <%= Number(activeChatId)===Number(c.id)?'active':'' %>" href="/admin?chat=<%= c.id %>#support-chat">
          <b><%= c.name || 'Пользователь' %> <% if(c.unread){ %><em><%= c.unread %></em><% } %></b>
          <small><%= c.email || '—' %></small>
        </a>
      <% }) %>
    </div>
    <div class="admin-chat-window">
      <% if(activeChatId){ %>
        <div class="admin-chat-messages">
          <% (supportMessages||[]).forEach(m=>{ %>
            <div class="admin-msg <%= m.author==='admin'?'admin':'user' %>">
              <span>
                <% if(m.message){ %><%= m.message %><% } %>
                <% if(m.attachment_name){ %><% if(String(m.attachment_mime||'').startsWith('image/')){ %><a class="support-photo admin-support-photo" href="/support/file/<%= m.id %>" target="_blank"><img src="/support/inline/<%= m.id %>" alt="<%= m.attachment_name %>"><span><%= m.attachment_name %></span></a><% } else { %><a class="support-attachment admin-attach-link" href="/support/file/<%= m.id %>" target="_blank">📎 <%= m.attachment_name %></a><% } %><% } %>
              </span>
              <small><%= new Date(m.created_at).toLocaleString('ru-RU') %></small>
            </div>
          <% }) %>
        </div>
        <form class="admin-chat-reply" method="post" enctype="multipart/form-data" action="/admin/support/<%= activeChatId %>/reply">
          <input name="message" maxlength="1200" placeholder="Введите ответ пользователю">
          <label class="mini admin-file-label">📎<input type="file" name="file" hidden></label>
          <button class="mini" type="submit">Ответить</button>
        </form>
      <% } else { %>
        <div class="admin-chat-empty big">Выберите диалог</div>
      <% } %>
    </div>
  </div>
</section>
<section class="filebox admin-payments-box"><h2>Ручные платежи Premium</h2><div class="table"><% (payments||[]).forEach(pay=>{ const waiting=pay.status==='waiting_admin'||pay.status==='pending'; const paid=pay.status==='paid'; const rejected=pay.status==='rejected'; %><div class="tr admin-payment-tr"><div><b><%= pay.plan==='trial'?'Пробный Premium 5 дней':'Premium на месяц' %> · <%= pay.amount %> ₽</b><small><%= pay.email || '—' %> · заказ <%= pay.id %> · <span class="pay-badge <%= paid?'paid':rejected?'rejected':waiting?'wait':'' %>"><%= paid?'подтверждён':rejected?'отклонён':pay.status==='waiting_admin'?'ждёт проверки':'создан' %></span><% if(pay.paid_at){ %> · <%= new Date(pay.paid_at).toLocaleString('ru-RU') %><% } %></small></div><div class="admin-pay-actions"><span class="mini order-copy"><%= pay.id %></span><% if(!paid){ %><form method="post" action="/admin/payments/<%= pay.id %>/approve"><button class="mini" type="submit">Подтвердить</button></form><form method="post" action="/admin/payments/<%= pay.id %>/reject"><button class="mini danger" type="submit">Отклонить</button></form><% } %></div></div><% }) %></div></section>

<section class="filebox"><h2>Файлы</h2><div class="table"><% files.forEach(f=>{ %><div class="tr"><div><b><%= f.original_name %></b><small><%= f.email %> · <%= fmt(f.size) %></small></div><a class="mini" href="/f/<%= f.id %>">Открыть</a><form method="post" action="/delete/<%= f.id %>"><button class="mini danger">Удалить</button></form></div><% }) %></div></section>

<section class="filebox"><h2>Пользователи</h2><div class="table admin-users"><% users.forEach(u=>{ const active=Number(u.premium_until||0)>now; %><div class="tr user-tr"><div><b><%= u.name %> <% if(active){ %><span class="premium-star">✦</span><% } %></b><small><%= u.email %> · <%= u.role %> <% if(active){ %>· Premium до <%= new Date(u.premium_until).toLocaleDateString('ru-RU') %><% } %></small></div><form method="post" action="/admin/users/<%= u.id %>/premium" class="premium-admin-form"><input name="days" type="number" min="1" max="365" value="30"><button class="mini" type="submit">Выдать Premium</button></form><form method="post" action="/admin/users/<%= u.id %>/premium/remove"><button class="mini danger" type="submit">Забрать</button></form></div><% }) %></div></section>
</main>
<script>
if(location.hash==='#support-chat' || new URLSearchParams(location.search).has('chat')){
  setInterval(()=>{ if(!document.hidden) location.reload(); }, 7000);
}
</script>
<script>(function(){var loader=document.getElementById('tcPreloader');if(!loader)return;var seen=false;try{seen=sessionStorage.getItem('tc_splash_seen')==='1'}catch(e){}if(seen){if(loader.parentNode)loader.parentNode.removeChild(loader);return}try{sessionStorage.setItem('tc_splash_seen','1')}catch(e){}var started=Date.now();var min=850;function hide(){var wait=Math.max(0,min-(Date.now()-started));setTimeout(function(){loader.classList.add('tc-preloader-hide');setTimeout(function(){if(loader&&loader.parentNode)loader.parentNode.removeChild(loader)},620)},wait)}if(document.readyState==='complete'){hide()}else{window.addEventListener('load',hide,{once:true});setTimeout(hide,2600)}})();</script></body></html>
