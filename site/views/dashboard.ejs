<form id="dropUpload" action="/upload" method="post" enctype="multipart/form-data"><input type="hidden" name="folder_id" value="<%= folder || '' %>"><input type="hidden" name="visibility" value="public"><input id="dropInput" type="file" name="file"></form>
<script>
const USER_IS_PREMIUM=<%= isPremium ? 'true' : 'false' %>;
const FILES=<%- JSON.stringify(files.map(f=>({id:f.id,slug:f.slug||f.id,name:f.original_name,size:fmt(f.size),views:f.views||0,downloads:f.downloads||0,lastDownload:f.last_download_at?new Date(f.last_download_at).toLocaleString('ru-RU',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}):'нет',private:!!f.is_private,expires:Math.max(0,Math.ceil((f.expires_at-now)/60000)),created:f.created_at || (f.expires_at-3600000)}))) %>;
const I18N={ru:{upload:'Загрузить файл',home:'Главная',files:'Файлы',settings:'Настройки',language:'Язык',theme:'Тема',premium:'Улучшить до Premium',premiumSub:'4 ГБ · 24 часа · ИИ · умный ИИ',cabinet:'Открыть кабинет',admin:'Админ-панель',logout:'Выйти',search:'Поиск...',dateSort:'По дате',newFolder:'Новая папка',noFiles:'Пока нет файлов',noFilesSub:'Загрузите свой первый файл или перетащите<br>его прямо сюда',deleteIn:'удалится через',min:'мин.',createFolder:'Создать папку',folderName:'Название папки',create:'Создать',publicFile:'Публичный файл',privateFile:'Приватный файл',uploading:'Файл загружается',uploadingSub:'Подождите пару секунд, он появится плавно',deleting:'Удаляем файл',deletingSub:'Сейчас он исчезнет из списка',changeName:'Изменить имя',changePassword:'Изменить пароль',save:'Сохранить',account:'Аккаунт',premiumSubShort:'4 ГБ · 24 часа · ИИ · умный ИИ',selected:'выбрано',selectAll:'Выбрать все',clearSelection:'Снять',rootFolder:'В корень',moveSelected:'Переместить',deleteSelected:'Удалить'},en:{upload:'Upload file',home:'Home',files:'Files',settings:'Settings',language:'Language',theme:'Theme',premium:'Upgrade to Premium',premiumSub:'4 GB per file and 24-hour storage',cabinet:'Open dashboard',admin:'Admin panel',logout:'Log out',search:'Search...',dateSort:'By date',newFolder:'New folder',noFiles:'No files yet',noFilesSub:'Upload your first file or drag it<br>right here',deleteIn:'deletes in',min:'min.',createFolder:'Create folder',folderName:'Folder name',create:'Create',publicFile:'Public file',privateFile:'Private file',uploading:'Uploading file',uploadingSub:'Wait a second, it will appear smoothly',deleting:'Deleting file',deletingSub:'It will disappear from the list now',changeName:'Change name',changePassword:'Change password',save:'Save',account:'Account',premiumSubShort:'4 GB per file and 24-hour storage',selected:'selected',selectAll:'Select all',clearSelection:'Clear',rootFolder:'Root',moveSelected:'Move',deleteSelected:'Delete'}};
let lang=localStorage.getItem('tc_lang')||'ru';let theme=localStorage.getItem('tc_theme')||'dark';
function applyLang(){document.documentElement.lang=lang;document.querySelectorAll('[data-i18n]').forEach(el=>{el.innerHTML=I18N[lang][el.dataset.i18n]||el.innerHTML});document.querySelectorAll('[data-i18n-placeholder]').forEach(el=>{el.placeholder=I18N[lang][el.dataset.i18nPlaceholder]||el.placeholder});document.getElementById('langBadge')&&(document.getElementById('langBadge').textContent=lang.toUpperCase());document.getElementById('drawerLang')&&(document.getElementById('drawerLang').textContent=lang.toUpperCase());}
function toggleLang(){lang=lang==='ru'?'en':'ru';localStorage.setItem('tc_lang',lang);applyLang();toast(lang==='ru'?'Русский язык':'English language')}
function applyTheme(){document.body.classList.toggle('light-theme',theme==='light');document.getElementById('themeBadge')&&(document.getElementById('themeBadge').textContent=theme);document.getElementById('drawerTheme')&&(document.getElementById('drawerTheme').textContent=theme);document.querySelector('#themeIcon use').setAttribute('href',theme==='light'?'#i-sun':'#i-moon')}
function toggleTheme(){theme=theme==='dark'?'light':'dark';localStorage.setItem('tc_theme',theme);applyTheme();toast(theme==='dark'?'Тёмная тема':'Светлая тема')}
function filterFiles(q){q=(q||'').toLowerCase();document.querySelectorAll('.search-item').forEach(c=>{c.style.display=c.dataset.name.includes(q)?'flex':'none'})}
function toggleSortMenu(e){e.stopPropagation();document.getElementById('sortMenu')?.classList.toggle('open')}
function sortFiles(mode){const grid=document.getElementById('files');if(!grid)return;const cards=[...grid.querySelectorAll('.file-card')];cards.sort((a,b)=>mode==='oldest'?Number(a.dataset.date)-Number(b.dataset.date):Number(b.dataset.date)-Number(a.dataset.date));cards.forEach(c=>grid.appendChild(c));document.getElementById('sortLabel').textContent=mode==='oldest'?(lang==='ru'?'Сначала старые':'Oldest first'):(lang==='ru'?'Сначала новые':'Newest first');document.getElementById('sortMenu')?.classList.remove('open');toast(mode==='oldest'?(lang==='ru'?'Показаны старые файлы':'Oldest files first'):(lang==='ru'?'Показаны новые файлы':'Newest files first'))}
function openMobileDrawer(){document.getElementById('mobileDrawer')?.classList.add('open');document.getElementById('mobileDrawerBackdrop')?.classList.add('open')}
function closeMobileDrawer(){document.getElementById('mobileDrawer')?.classList.remove('open');document.getElementById('mobileDrawerBackdrop')?.classList.remove('open')}
function toggleMobileAccount(force){const el=document.getElementById('mobileAccountSheet');if(!el)return;el.classList.toggle('open',typeof force==='boolean'?force:!el.classList.contains('open'))}
function toast(t){const el=document.getElementById('toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),1800)}
function showActionLoader(id){const el=document.getElementById(id);if(!el)return;el.classList.add('show');el.setAttribute('aria-hidden','false')}
function hideActionLoader(id){const el=document.getElementById(id);if(!el)return;el.classList.remove('show');el.setAttribute('aria-hidden','true')}
function setUploadProgress(p){const bar=document.getElementById('uploadProgressBar'),txt=document.getElementById('uploadProgressText');if(bar)bar.style.width=Math.max(0,Math.min(100,p))+'%';if(txt)txt.textContent=Math.round(p)+'%'}
function uploadFormXHR(form,file,visibility){closeUploadMenus();showActionLoader('uploadLoader');setUploadProgress(0);const fd=new FormData();fd.append('file',file);const folder=form.querySelector('[name=folder_id]')?.value||'';fd.append('folder_id',folder);fd.append('visibility',visibility||'public');if((visibility||'public')==='private'){const pass=window.__pendingPrivatePassword||'';fd.append('file_password',pass);window.__pendingPrivatePassword='';}const xhr=new XMLHttpRequest();xhr.open('POST','/upload');xhr.setRequestHeader('X-Requested-With','XMLHttpRequest');xhr.setRequestHeader('Accept','application/json');xhr.upload.onprogress=e=>{if(e.lengthComputable)setUploadProgress((e.loaded/e.total)*92)};xhr.onload=()=>{let r={};try{r=JSON.parse(xhr.responseText||'{}')}catch(e){}if(xhr.status>=400||r.ok===false){hideActionLoader('uploadLoader');toast(r.error||(lang==='ru'?'Ошибка загрузки':'Upload error'));return}setUploadProgress(100);setTimeout(()=>{location.href=r.redirect||'/dashboard'},360)};xhr.onerror=()=>{hideActionLoader('uploadLoader');toast(lang==='ru'?'Ошибка загрузки':'Upload error')};xhr.send(fd)}
let __pendingPrivateUpload=null;
function startUploadAnimation(input,visibility){
  if(!input.files||!input.files.length)return;
  const v=visibility||input.dataset.visibility||'public';
  if(v==='private'){
    __pendingPrivateUpload={input,visibility:v};
    const m=document.getElementById('privatePassModal');
    const err=document.getElementById('privatePassError');
    const pass=document.getElementById('privatePassInput');
    if(err)err.textContent='';
    if(pass){pass.value='';setTimeout(()=>pass.focus(),80)}
    if(m){m.classList.add('open');m.setAttribute('aria-hidden','false')}
    return;
  }
  uploadFormXHR(input.form,input.files[0],v);
}
function cancelPrivatePassword(){
  const m=document.getElementById('privatePassModal');
  if(m){m.classList.remove('open');m.setAttribute('aria-hidden','true')}
  if(__pendingPrivateUpload?.input)__pendingPrivateUpload.input.value='';
  __pendingPrivateUpload=null;
}
function confirmPrivatePassword(){
  const passEl=document.getElementById('privatePassInput');
  const err=document.getElementById('privatePassError');
  const pass=(passEl?.value||'').trim();
  if(pass.length<4){if(err)err.textContent='Минимум 4 символа';passEl?.focus();return}
  const pending=__pendingPrivateUpload;
  if(!pending?.input||!pending.input.files||!pending.input.files.length){cancelPrivatePassword();return}
  window.__pendingPrivatePassword=pass;
  const m=document.getElementById('privatePassModal');
  if(m){m.classList.remove('open');m.setAttribute('aria-hidden','true')}
  __pendingPrivateUpload=null;
  uploadFormXHR(pending.input.form,pending.input.files[0],pending.visibility);
}
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&document.getElementById('privatePassModal')?.classList.contains('open'))confirmPrivatePassword();if(e.key==='Escape'&&document.getElementById('privatePassModal')?.classList.contains('open'))cancelPrivatePassword();});
function toggleProfileMenu(e){e.stopPropagation();closeUploadMenus();document.getElementById('profileMenu').classList.toggle('open')}
function toggleUploadMenu(e,btn){e.preventDefault();e.stopPropagation();const wrap=btn.closest('.upload-choice-wrap');const was=wrap.classList.contains('open');closeUploadMenus();if(!was)wrap.classList.add('open')}
function closeUploadMenus(){document.querySelectorAll('.upload-choice-wrap.open').forEach(w=>w.classList.remove('open'))}
document.addEventListener('click',()=>{document.getElementById('profileMenu')?.classList.remove('open');document.getElementById('sortMenu')?.classList.remove('open');closeUploadMenus();});
function openFolderModal(){document.getElementById('folderModal').classList.add('open');setTimeout(()=>document.querySelector('#folderModal input')?.focus(),50)}function closeFolderModal(){document.getElementById('folderModal').classList.remove('open')}function openNameModal(){document.getElementById('nameModal').classList.add('open');document.getElementById('profileMenu')?.classList.remove('open')}function closeNameModal(){document.getElementById('nameModal').classList.remove('open')}function openPasswordModal(){document.getElementById('passwordModal').classList.add('open');document.getElementById('profileMenu')?.classList.remove('open')}function closePasswordModal(){document.getElementById('passwordModal').classList.remove('open')}function openPremiumModal(){document.getElementById('premiumModal')?.classList.add('open');selectPremiumPlan(document.querySelector('[name=plan]:checked')?.value||'month')}function closePremiumModal(){document.getElementById('premiumModal')?.classList.remove('open')}function selectPremiumPlan(plan){document.querySelectorAll('.premium-plan').forEach(l=>{const checked=l.querySelector('input')?.value===plan;l.classList.toggle('active',checked);const input=l.querySelector('input');if(input)input.checked=checked});const btn=document.getElementById('premiumPayBtn');const after=document.getElementById('premiumAfter');if(btn){btn.href='/premium/pay?plan='+plan;btn.textContent=plan==='trial'?'Оформить 5 дней за 3 ₽':'Оформить за 60 ₽'}if(after)after.textContent=plan==='trial'?'Пробный Premium на 5 дней. Перевод на YooMoney вручную.':'Premium на 1 месяц. Перевод на YooMoney вручную.'}function premiumPayClick(e){const ok=document.getElementById('premiumAgree')?.checked;if(!ok){e.preventDefault();toast(lang==='ru'?'Сначала поставьте галочку согласия':'Please accept first');return false}return true}
function copyLink(v){navigator.clipboard.writeText(v);toast(lang==='ru'?'Ссылка скопирована':'Link copied')}
function openDetails(i){const f=FILES[i], url=location.origin+'/file/'+(f.slug||f.id), tg='https://t.me/share/url?url='+encodeURIComponent(url), lock=f.private?'<span class="privacy-badge"><svg><use href="#i-lock"/></svg>'+(lang==='ru'?'Приватный':'Private')+'</span>':'<span class="privacy-badge public"><svg><use href="#i-upload"/></svg>'+(lang==='ru'?'Публичный':'Public')+'</span>';document.getElementById('detailsInner').innerHTML=`<h2><svg><use href="${f.private?'#i-lock':'#i-file'}"/></svg><span>${escapeHtml(f.name)}</span></h2>${lock}<label>${lang==='ru'?'Красивая ссылка на файл':'Pretty file link'}</label><div class="linkrow"><input readonly value="${url}"><button onclick="copyLink('${url}')"><svg><use href='#i-copy'/></svg></button><a href="${url}" target="_blank"><svg><use href='#i-external'/></svg></a></div><h3>${lang==='ru'?'Статистика':'Stats'}</h3><div class="detail-stats"><div><b id="detailViews">${f.views||0}</b><span>${lang==='ru'?'Просмотры':'Views'}</span></div><div><b id="detailDownloads">${f.downloads}</b><span>${lang==='ru'?'Скачивания':'Downloads'}</span></div><div><b id="detailExpires">${f.expires}</b><span>${lang==='ru'?'Минут':'Minutes'}</span></div><div><b id="detailAccess">${f.private?'🔒':'🌍'}</b><span>${lang==='ru'?'Доступ':'Access'}</span></div></div><div class="detail-card"><b>${lang==='ru'?'Последнее скачивание':'Last download'}</b><span id="detailLastDownload">${f.lastDownload||'нет'}</span></div><div class="detail-card"><b>${lang==='ru'?'Тип ссылки':'Link type'}</b><strong>${f.private?(lang==='ru'?'Приватная':'Private'):(lang==='ru'?'Публичная':'Public')}</strong><p>${f.private?(lang==='ru'?'Файл доступен только владельцу аккаунта и защищён паролем.':'Only the account owner can open this file.'):(lang==='ru'?'Любой человек со ссылкой сможет скачать файл.':'Anyone with the link can download this file.')}</p></div><div class="detail-actions"><button onclick="copyLink('${url}')"><svg><use href='#i-copy'/></svg> ${lang==='ru'?'Скопировать':'Copy'}</button><form method="post" action="/delete/${f.id}"><button class="red" type="submit"><svg><use href='#i-trash'/></svg> ${lang==='ru'?'Удалить':'Delete'}</button></form></div>`;document.getElementById('detailsPanel').classList.add('open');document.body.classList.add('details-open');window.__openDetailFileId=f.id;refreshOpenFileStats();}
async function refreshOpenFileStats(){if(!window.__openDetailFileId)return;try{const r=await fetch('/api/file/'+encodeURIComponent(window.__openDetailFileId)+'/stats',{cache:'no-store'}).then(x=>x.json());if(!r.ok)return;const s=r.stats;const f=FILES.find(x=>x.id===window.__openDetailFileId);if(f){f.views=s.views;f.downloads=s.downloads;f.expires=s.expires;f.lastDownload=s.lastDownload}document.getElementById('detailViews')&&(document.getElementById('detailViews').textContent=s.views);document.getElementById('detailDownloads')&&(document.getElementById('detailDownloads').textContent=s.downloads);document.getElementById('detailExpires')&&(document.getElementById('detailExpires').textContent=s.expires);document.getElementById('detailLastDownload')&&(document.getElementById('detailLastDownload').textContent=s.lastDownload)}catch(e){}}
setInterval(refreshOpenFileStats,2500);
function closeDetails(){document.getElementById('detailsPanel').classList.remove('open');document.body.classList.remove('details-open')}
function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
const dz=document.getElementById('dropZone');let driveDragDepth=0;if(dz){dz.addEventListener('dragenter',e=>{e.preventDefault();driveDragDepth++;dz.classList.add('dragover')});dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('dragover')});dz.addEventListener('dragleave',e=>{e.preventDefault();driveDragDepth=Math.max(0,driveDragDepth-1);if(!driveDragDepth)dz.classList.remove('dragover')});dz.addEventListener('drop',e=>{e.preventDefault();driveDragDepth=0;dz.classList.remove('dragover');const f=e.dataTransfer.files[0];if(!f)return;const input=document.getElementById('dropInput');const dt=new DataTransfer();dt.items.add(f);input.files=dt.files;uploadFormXHR(document.getElementById('dropUpload'),f,'public')});}
document.addEventListener('submit',e=>{const form=e.target;if(!form.action||!form.action.includes('/delete/'))return;e.preventDefault();if(typeof closeFileMenu==='function')closeFileMenu();if(typeof clearSelection==='function')clearSelection();showActionLoader('deleteLoader');const card=form.closest('.file-card')||document.querySelector('.file-card:hover');if(card)card.classList.add('file-removing');setTimeout(()=>form.submit(),720)});


function selectedIds(){return [...document.querySelectorAll('.select-file input:checked')].map(i=>i.value)}
function updateSelection(){const ids=selectedIds();document.querySelectorAll('.file-card').forEach(c=>{const cb=c.querySelector('.select-file input');c.classList.toggle('selected',!!cb?.checked)});const bar=document.getElementById('selectionToolbar');if(bar){bar.classList.toggle('open',ids.length>0);bar.setAttribute('aria-hidden',ids.length?'false':'true')}const cnt=document.getElementById('selectedCount');if(cnt)cnt.textContent=ids.length}
function selectAllFiles(){document.querySelectorAll('.file-card:not([style*="display: none"]) .select-file input').forEach(i=>i.checked=true);updateSelection()}
function clearSelection(){document.querySelectorAll('.select-file input').forEach(i=>i.checked=false);updateSelection()}
function submitBulkDelete(){const ids=selectedIds();if(!ids.length)return toast(lang==='ru'?'Выберите файлы':'Select files');if(!confirm(lang==='ru'?'Удалить выбранные файлы?':'Delete selected files?'))return;if(typeof closeFileMenu==='function')closeFileMenu();document.getElementById('selectionToolbar')?.classList.remove('open');document.getElementById('selectionToolbar')?.setAttribute('aria-hidden','true');document.getElementById('bulkDeleteIds').value=ids.join(',');showActionLoader('deleteLoader');document.querySelectorAll('.file-card.selected').forEach(c=>c.classList.add('file-removing'));setTimeout(()=>document.getElementById('bulkDeleteForm').submit(),520)}
function submitBulkMove(){const ids=selectedIds();if(!ids.length)return toast(lang==='ru'?'Выберите файлы':'Select files');document.getElementById('bulkMoveIds').value=ids.join(',');toast(lang==='ru'?'Перемещаем файлы':'Moving files');document.getElementById('bulkMoveForm').submit()}

function b64urlToBuf(v){const pad='='.repeat((4-v.length%4)%4);const s=(v+pad).replace(/-/g,'+').replace(/_/g,'/');const bin=atob(s);const buf=new ArrayBuffer(bin.length);const bytes=new Uint8Array(buf);for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);return buf}
function bufToB64url(buf){const bytes=new Uint8Array(buf);let bin='';bytes.forEach(b=>bin+=String.fromCharCode(b));return btoa(bin).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function prepRegOptions(o){o.challenge=b64urlToBuf(o.challenge);if(o.user&&typeof o.user.id==='string')o.user.id=b64urlToBuf(o.user.id);if(o.excludeCredentials)o.excludeCredentials=o.excludeCredentials.map(c=>({...c,id:b64urlToBuf(c.id)}));return o}
function packRegCredential(c){return {id:c.id,rawId:bufToB64url(c.rawId),type:c.type,response:{attestationObject:bufToB64url(c.response.attestationObject),clientDataJSON:bufToB64url(c.response.clientDataJSON),transports:c.response.getTransports?c.response.getTransports():[]},clientExtensionResults:c.getClientExtensionResults?c.getClientExtensionResults():{}}}
async function registerPasskey(btn){try{if(!window.PublicKeyCredential)throw new Error('passkeys_not_supported');btn.classList.add('loading');toast('Открой окно Windows Hello / Face ID');const opt=await fetch('/passkey/register/options',{method:'POST'}).then(r=>r.json());const cred=await navigator.credentials.create({publicKey:prepRegOptions(opt)});const result=await fetch('/passkey/register/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(packRegCredential(cred))}).then(r=>r.json());toast(result.ok?'Быстрый вход привязан':'Не удалось привязать passkey')}catch(e){toast('Passkey доступен только на HTTPS или localhost')}finally{btn.classList.remove('loading');document.getElementById('profileMenu')?.classList.remove('open')}}

function openFileMenu(e,idx){e.preventDefault();e.stopPropagation();document.querySelector('.ios-file-menu')?.remove();const f=FILES[idx];const r=e.target.getBoundingClientRect();const menu=document.createElement('div');menu.className='ios-file-menu';menu.innerHTML=`<button type="button" onclick="selectOneFromMenu('${f.id}')">Выбрать</button><button type="button" onclick="selectAllFiles();closeFileMenu()">Выбрать все</button><button class="danger" type="button" onclick="deleteFileFromMenu('${f.id}')"><svg><use href='#i-trash'/></svg>Удалить</button>`;document.body.appendChild(menu);const mw=240;let left=Math.min(innerWidth-mw-14,Math.max(14,r.right-mw+8));let top=Math.min(innerHeight-210,Math.max(12,r.bottom+8));menu.style.left=left+'px';menu.style.top=top+'px';requestAnimationFrame(()=>menu.classList.add('open'))}
function closeFileMenu(){const m=document.querySelector('.ios-file-menu');if(!m)return;m.classList.remove('open');m.classList.add('removing');setTimeout(()=>m.remove(),140)}
function selectOneFromMenu(id){const cb=document.querySelector(`.select-file input[value="${CSS.escape(id)}"]`);if(cb){cb.checked=true;updateSelection()}closeFileMenu()}
function deleteFileFromMenu(id){closeFileMenu();if(typeof clearSelection==='function')clearSelection();showActionLoader('deleteLoader');const card=document.querySelector(`.file-card[data-id="${CSS.escape(id)}"]`);if(card)card.classList.add('file-removing');const form=document.createElement('form');form.method='post';form.action='/delete/'+encodeURIComponent(id);form.style.display='none';document.body.appendChild(form);setTimeout(()=>form.submit(),520)}
document.addEventListener('click',e=>{if(!e.target.closest('.ios-file-menu')&&!e.target.closest('.file-dots'))closeFileMenu()});
let supportTimer=null,lastSupportHash='';
function escapeHtml(v){return String(v||'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]))}
function fmtSupportSize(n){n=Number(n||0);if(!n)return '';if(n<1024)return n+' Б';if(n<1024*1024)return Math.round(n/1024)+' КБ';return (n/1024/1024).toFixed(1)+' МБ'}

function isSupportImage(m){return String(m.attachment_mime||'').startsWith('image/')}
function supportAttachmentHtml(m){
  if(!m.attachment_name)return '';
  const name=escapeHtml(m.attachment_name);
  const size=fmtSupportSize(m.attachment_size);
  const fileUrl='/support/file/'+encodeURIComponent(m.id);
  const inlineUrl='/support/inline/'+encodeURIComponent(m.id);
  if(isSupportImage(m)){
    return '<a class="support-photo" href="'+fileUrl+'" target="_blank"><img src="'+inlineUrl+'" alt="'+name+'"><span>'+name+' · '+size+'</span></a>';
  }
  return '<a class="support-attachment" href="'+fileUrl+'" target="_blank">📎 '+name+' <small>'+size+'</small></a>';
}
async function loadSupportMessages(force=false){const box=document.getElementById('supportMessages');if(!box)return;try{const r=await fetch('/support/messages',{cache:'no-store'}).then(x=>x.json());if(!r.ok)return;const hash=JSON.stringify(r.messages||[]);if(!force&&hash===lastSupportHash)return;lastSupportHash=hash;box.innerHTML=r.messages.length?'':'<div class="support-empty">Напишите вопрос — мы поможем.</div>';r.messages.forEach(m=>{const el=document.createElement('div');el.className='support-bubble '+(m.author==='admin'?'admin':'user');let html='';if(m.message)html+='<div>'+escapeHtml(m.message)+'</div>';if(m.attachment_name)html+=supportAttachmentHtml(m);el.innerHTML=html;box.appendChild(el)});box.scrollTop=box.scrollHeight}catch(e){}}
function openSupportChat(){const chat=document.getElementById('supportChat');if(!chat)return;chat.classList.remove('closing');chat.classList.add('open');setTimeout(()=>document.getElementById('supportInput')?.focus(),260);loadSupportMessages(true);clearInterval(supportTimer);supportTimer=setInterval(()=>loadSupportMessages(false),1800)}
function closeSupportChat(){const chat=document.getElementById('supportChat');if(!chat)return;chat.classList.add('closing');clearInterval(supportTimer);supportTimer=null;setTimeout(()=>{chat.classList.remove('closing');chat.classList.remove('open')},420)}
function showSupportFileName(){const f=document.getElementById('supportFile')?.files?.[0];const chip=document.getElementById('supportFileChip');if(!chip)return;if(!f){chip.style.display='none';chip.innerHTML='';return}chip.style.display='block';chip.innerHTML='Прикреплён файл: <b>'+escapeHtml(f.name)+'</b> <button type="button" onclick="clearSupportFile()">×</button>'}
function clearSupportFile(){const input=document.getElementById('supportFile');if(input)input.value='';showSupportFileName()}
async function sendSupportMessage(e){e.preventDefault();const input=document.getElementById('supportInput');const file=document.getElementById('supportFile');const msg=(input.value||'').trim();if(!msg&&!(file&&file.files&&file.files[0]))return;const fd=new FormData();fd.append('message',msg);if(file&&file.files&&file.files[0])fd.append('file',file.files[0]);input.value='';clearSupportFile();await fetch('/support/messages',{method:'POST',body:fd});loadSupportMessages(true)}async function askAiSupport(){if(!USER_IS_PREMIUM){openPremiumModal();toast('ИИ-помощник доступен в Premium');return}const input=document.getElementById('supportInput');const btn=document.getElementById('supportAiBtn');const msg=(input?.value||'').trim();try{if(btn)btn.classList.add('loading');if(msg){const fd=new FormData();fd.append('message',msg);input.value='';await fetch('/support/messages',{method:'POST',body:fd});await loadSupportMessages(true)}const box=document.getElementById('supportMessages');let thinking=null;if(box){thinking=document.createElement('div');thinking.className='support-message-row admin support-thinking';thinking.innerHTML='<div class="support-avatar">✨</div><div class="support-message-body"><div class="support-author">ИИ-помощник</div><div class="support-bubble admin"><span></span><span></span><span></span></div></div>';box.appendChild(thinking);box.scrollTop=box.scrollHeight}const r=await fetch('/api/ai-support',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg})}).then(x=>x.json());if(thinking)thinking.remove();if(r.premium_required){openPremiumModal();toast('ИИ-помощник доступен в Premium');return}if(!r.ok)toast(r.message||'ИИ пока не подключён');await loadSupportMessages(true)}catch(e){toast('ИИ сейчас не ответил')}finally{if(btn)btn.classList.remove('loading')}}


let statsChartState={labels:[],views:[],downloads:[]};
function money(v,d=2){return '$'+Number(v||0).toFixed(d)}
function initStatsChartFromDays(days){if(!Array.isArray(days))return;statsChartState.labels=days.map(x=>x.label);statsChartState.views=days.map(x=>Number(x.views||0));statsChartState.downloads=days.map(x=>Number(x.downloads||0));drawStatsChart()}
function drawStatsChart(){const canvas=document.getElementById('statsLiveChart');if(!canvas)return;const ctx=canvas.getContext('2d');const dpr=Math.max(1,window.devicePixelRatio||1);const rect=canvas.getBoundingClientRect();const w=Math.max(320,Math.floor(rect.width*dpr));const h=Math.max(190,Math.floor(rect.height*dpr));if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h}ctx.clearRect(0,0,w,h);const pad=34*dpr;const labels=statsChartState.labels.length?statsChartState.labels:['сейчас'];const views=statsChartState.views.length?statsChartState.views:[0];const downloads=statsChartState.downloads.length?statsChartState.downloads:[0];const max=Math.max(1,...views,...downloads);const plotW=w-pad*2,plotH=h-pad*2;const gx=i=>pad+(labels.length===1?plotW:plotW*i/(labels.length-1));const gy=v=>pad+plotH-(v/max)*plotH;ctx.save();ctx.globalAlpha=.45;ctx.strokeStyle='rgba(255,255,255,.09)';ctx.lineWidth=1*dpr;for(let i=0;i<5;i++){const y=pad+plotH*i/4;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(w-pad,y);ctx.stroke()}ctx.restore();function line(data,color,fill){ctx.beginPath();data.forEach((v,i)=>{const x=gx(i),y=gy(v);if(i===0)ctx.moveTo(x,y);else{const px=gx(i-1),py=gy(data[i-1]);const cx=(px+x)/2;ctx.bezierCurveTo(cx,py,cx,y,x,y)}});if(fill){const grad=ctx.createLinearGradient(0,pad,0,h-pad);grad.addColorStop(0,fill);grad.addColorStop(1,'rgba(0,0,0,0)');ctx.lineTo(gx(data.length-1),h-pad);ctx.lineTo(gx(0),h-pad);ctx.closePath();ctx.fillStyle=grad;ctx.fill();ctx.beginPath();data.forEach((v,i)=>{const x=gx(i),y=gy(v);if(i===0)ctx.moveTo(x,y);else{const px=gx(i-1),py=gy(data[i-1]);const cx=(px+x)/2;ctx.bezierCurveTo(cx,py,cx,y,x,y)}})}ctx.strokeStyle=color;ctx.lineWidth=3*dpr;ctx.lineCap='round';ctx.lineJoin='round';ctx.shadowColor=color;ctx.shadowBlur=14*dpr;ctx.stroke();ctx.shadowBlur=0;const lastX=gx(data.length-1),lastY=gy(data[data.length-1]||0);ctx.fillStyle=color;ctx.beginPath();ctx.arc(lastX,lastY,4.5*dpr,0,Math.PI*2);ctx.fill()}line(views,'#3b82ff','rgba(59,130,255,.18)');line(downloads,'#8b5cf6','rgba(139,92,246,.16)');ctx.fillStyle='rgba(255,255,255,.55)';ctx.font=(11*dpr)+'px system-ui, sans-serif';ctx.fillText(String(max),pad,18*dpr);ctx.fillText('0',pad,h-10*dpr)}
async function refreshStatsPage(){const box=document.getElementById('statsDashboard');if(!box)return;try{const r=await fetch('/api/stats',{cache:'no-store'}).then(x=>x.json());if(!r.ok)return;const s=r.stats||{};const views=Number(s.views||0),downloads=Number(s.downloads||0),visitors=Number(s.visitors||0);const revenue=(views/1000)*0.1;const rate=views?downloads/views*100:0;const visitorRevenue=visitors?revenue/visitors:0;const set=(id,val)=>{const el=document.getElementById(id);if(el&&el.textContent!==String(val)){el.classList.add('stat-pulse');el.textContent=val;setTimeout(()=>el.classList.remove('stat-pulse'),420)}};set('kpiRate',rate.toFixed(2)+'%');set('kpiRpm',money(revenue,2));set('kpiVisitor',money(visitorRevenue,3));set('kpiViews',views+' просмотров');set('kpiDownloads',downloads+' скач.');set('kpiVisitors',visitors+' посет.');if(Array.isArray(s.days))initStatsChartFromDays(s.days)}catch(e){}}
if(document.getElementById('statsDashboard')){refreshStatsPage();setInterval(refreshStatsPage,2200);window.addEventListener('resize',drawStatsChart)}

applyLang();applyTheme();

/* ===== v40 premium support chat behavior ===== */
function supportTime(ts){try{return new Date(ts||Date.now()).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'})}catch(e){return ''}}
function supportAuthor(author){return author==='admin'?'Поддержка':'Пользователь'}
function supportAvatar(author){return author==='admin'?'🤖':'👤'}
async function loadSupportMessages(force=false){const box=document.getElementById('supportMessages');if(!box)return;try{const r=await fetch('/support/messages',{cache:'no-store'}).then(x=>x.json());if(!r.ok)return;const hash=JSON.stringify(r.messages||[]);if(!force&&hash===lastSupportHash)return;lastSupportHash=hash;box.innerHTML=r.messages.length?'':'<div class="support-empty">Напишите вопрос — мы поможем.</div>';(r.messages||[]).forEach(m=>{const row=document.createElement('div');row.className='support-message-row '+(m.author==='admin'?'admin':'user');let html='<div class="support-avatar">'+supportAvatar(m.author)+'</div><div class="support-message-body"><div class="support-author">'+supportAuthor(m.author)+'</div><div class="support-bubble '+(m.author==='admin'?'admin':'user')+'">';if(m.message)html+='<div>'+escapeHtml(m.message)+'</div>';if(m.attachment_name)html+=supportAttachmentHtml(m);html+='</div><div class="support-time">'+supportTime(m.created_at)+'</div></div>';row.innerHTML=html;box.appendChild(row)});box.scrollTop=box.scrollHeight}catch(e){}}
function showSupportFileName(){const f=document.getElementById('supportFile')?.files?.[0];const chip=document.getElementById('supportFileChip');if(!chip)return;if(!f){chip.style.display='none';chip.innerHTML='';return}chip.style.display='block';chip.innerHTML='👀 Файл готов: <b>'+escapeHtml(f.name)+'</b> <button type="button" onclick="clearSupportFile()">×</button>'}
function initPremiumSupportDrag(){const chat=document.getElementById('supportChat');const file=document.getElementById('supportFile');if(!chat||!file||chat.dataset.dragReady)return;chat.dataset.dragReady='1';['dragenter','dragover'].forEach(ev=>chat.addEventListener(ev,e=>{e.preventDefault();chat.classList.add('dragging')}));['dragleave','drop'].forEach(ev=>chat.addEventListener(ev,e=>{e.preventDefault();if(ev==='drop'&&e.dataTransfer?.files?.length){file.files=e.dataTransfer.files;showSupportFileName();document.getElementById('supportInput')?.focus()}chat.classList.remove('dragging')}));}
const _oldOpenSupportChat=openSupportChat;openSupportChat=function(){_oldOpenSupportChat();initPremiumSupportDrag();}
document.addEventListener('DOMContentLoaded',initPremiumSupportDrag);
</script>
<script>(function(){var loader=document.getElementById('tcPreloader');if(!loader)return;var seen=false;try{seen=sessionStorage.getItem('tc_splash_seen')==='1'}catch(e){}if(seen){if(loader.parentNode)loader.parentNode.removeChild(loader);return}try{sessionStorage.setItem('tc_splash_seen','1')}catch(e){}var started=Date.now();var min=850;function hide(){var wait=Math.max(0,min-(Date.now()-started));setTimeout(function(){loader.classList.add('tc-preloader-hide');setTimeout(function(){if(loader&&loader.parentNode)loader.parentNode.removeChild(loader)},620)},wait)}if(document.readyState==='complete'){hide()}else{window.addEventListener('load',hide,{once:true});setTimeout(hide,2600)}})();</script></body></html>
