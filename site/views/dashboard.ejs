<!doctype html><html lang="ru"><%- include('head',{title}) %><body class="drive-app"><script>try{if(sessionStorage.getItem('tc_splash_seen')==='1')document.documentElement.classList.add('tc-splash-seen')}catch(e){}</script><div id="tcPreloader" class="tc-preloader" aria-hidden="true"><div class="tc-preloader-mark"><span class="tc-preloader-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.parentElement.classList.add('fallback')"></span><span class="tc-preloader-name">Turov Cloud</span></div></div>
<svg style="display:none" aria-hidden="true">
  <symbol id="i-logo" viewBox="0 0 24 24"><path d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M14 3v5h5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 15h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-upload" viewBox="0 0 24 24"><path d="M12 16V5m0 0 4 4m-4-4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 19h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-home" viewBox="0 0 24 24"><path d="m4 11 8-7 8 7v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 21v-6h6v6" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-grid" viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-list" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 6h.01M3 12h.01M3 18h.01" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></symbol>
  <symbol id="i-stats" viewBox="0 0 24 24"><path d="M5 19V10M12 19V5M19 19v-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M4 19h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
  <symbol id="i-file" viewBox="0 0 24 24"><path d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M14 3v5h5" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-lock" viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="2"/><rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M21 14.7A8 8 0 0 1 9.3 3 9 9 0 1 0 21 14.7Z" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-sun" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2m0 16v2M4 12H2m20 0h-2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-lang" viewBox="0 0 24 24"><path d="M4 5h10M9 3v2m1 14 5-11 5 11m-8-4h6M5 8c1 4 4 7 8 8m0-8c-1 3-4 7-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-copy" viewBox="0 0 24 24"><path d="M8 8h11v11H8z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 16H4a1 1 0 0 1-1-1V5a2 2 0 0 1 2-2h10a1 1 0 0 1 1 1v1" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-external" viewBox="0 0 24 24"><path d="M14 4h6v6M10 14 20 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m-10 0 1 15h10l1-15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>

  <symbol id="i-user" viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 21a8 8 0 0 1 16 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-card" viewBox="0 0 24 24"><path d="M4 7h16a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M2 11h20M6 15h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 4h4a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol><symbol id="i-key" viewBox="0 0 24 24"><path d="M14 7a5 5 0 1 0 2.2 4.1L22 5.3V3h-2.3l-1.4 1.4L17 3.1 15.1 5 16.4 6.3 15 7.7A5 5 0 0 0 14 7Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 12h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></symbol></svg>
<aside class="drive-sidebar">
  <button class="mobile-menu-toggle" type="button" onclick="openMobileDrawer()" aria-label="Меню"><svg><use href="#i-menu"/></svg></button>
  <a class="drive-brand" href="/dashboard"><span class="drive-logo asset-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='block'"><svg><use href="#i-logo"/></svg></span><span>Turov Cloud</span></a>
  <div class="side-upload-form">
    <form action="/upload" method="post" enctype="multipart/form-data" class="upload-choice-wrap">
      <input type="hidden" name="folder_id" value="<%= folder || '' %>">
      <button class="drive-upload upload-trigger" type="button" onclick="toggleUploadMenu(event,this)"><svg><use href="#i-upload"/></svg><span data-i18n="upload">Загрузить файл</span></button>
      <div class="upload-menu">
        <label class="upload-menu-item"><svg><use href="#i-upload"/></svg><span data-i18n="publicFile">Публичный файл</span><input name="file" type="file" data-visibility="public" onchange="startUploadAnimation(this,'public')"></label>
        <label class="upload-menu-item"><svg><use href="#i-lock"/></svg><span data-i18n="privateFile">Приватный файл</span><input name="file" type="file" data-visibility="private" onchange="startUploadAnimation(this,'private')"></label>
      </div>
    </form>
    <button class="round-upload" type="button" title="Новая папка" onclick="openFolderModal()"><svg><use href="#i-folder"/></svg></button>
  </div>
  <nav class="drive-nav">
    <a class="<%= tab==='files'?'active':'' %>" href="/dashboard"><span><svg><use href="#i-home"/></svg></span><b data-i18n="home">Главная</b></a>
    <a class="<%= tab==='files'?'active':'' %>" href="/dashboard"><span><svg><use href="#i-folder"/></svg></span><b data-i18n="files">Файлы</b><em><%= files.length + folders.length %></em></a>
    <a class="<%= tab==='stats'?'active':'' %>" href="/dashboard?tab=stats"><span><svg><use href="#i-stats"/></svg></span><b>Статистика</b></a>
    <button type="button" class="nav-fake support-nav" onclick="openSupportChat()"><span class="support-mini-icon">💬</span><b>Поддержка</b></button>
  </nav>
  <div class="settings-title" data-i18n="settings">Настройки</div>
  <nav class="drive-nav compact">
    <button type="button" class="nav-fake" onclick="toggleLang()"><span><svg><use href="#i-lang"/></svg></span><b data-i18n="language">Язык</b><i id="langBadge">RU</i></button>
    <button type="button" class="nav-fake" onclick="toggleTheme()"><span><svg id="themeIcon"><use href="#i-moon"/></svg></span><b data-i18n="theme">Тема</b><i id="themeBadge">dark</i></button>
  </nav>
  <% if(!isPremium){ %><button class="drive-premium" type="button" onclick="openPremiumModal()"><b data-i18n="premium">Улучшить до Premium</b><small data-i18n="premiumSub">4 ГБ · 24 часа · умный ИИ</small><i>›</i></button><% } else { %><div class="premium-active-card"><b>Premium активен <span class="premium-star">✦</span></b><small>4 ГБ · 24 часа · умный ИИ</small></div><% } %>
  <div class="drive-profile">
    <span><%= (user.name||'U').slice(0,1).toLowerCase() %></span>
    <div><b><%= user.name %> <% if(isPremium){ %><span class="premium-star" title="Premium">✦</span><% } %></b><small><%= user.email %></small></div>
    <button type="button" onclick="toggleProfileMenu(event)" aria-label="Меню профиля">⋮</button>
    <div class="profile-menu account-popover" id="profileMenu">
      <div class="account-head"><span><%= (user.name||'U').slice(0,1).toLowerCase() %></span><div><b><%= user.name %> <% if(isPremium){ %><span class="premium-star" title="Premium">✦</span><% } %></b><small><%= user.email %></small></div></div>
      <button type="button" onclick="openNameModal()"><svg><use href="#i-user"/></svg><span data-i18n="changeName">Изменить имя</span></button>
      <button type="button" onclick="openPasswordModal()"><svg><use href="#i-card"/></svg><span data-i18n="changePassword">Изменить пароль</span></button>
      <button type="button" onclick="registerPasskey(this)"><svg><use href="#i-key"/></svg><span>Face ID / Windows Hello</span></button>
      <% if(user.role==='admin'){ %><a href="/admin"><svg><use href="#i-logo"/></svg><span data-i18n="admin">Админ-панель</span></a><% } %>
      <form method="post" action="/logout"><button type="submit"><svg><use href="#i-logout"/></svg><span data-i18n="logout">Выйти</span></button></form>
    </div>
  </div>
</aside>
<main class="drive-main">
  <header class="drive-topbar"><button class="iconbtn"><svg><use href="#i-logo"/></svg></button><div class="divider"></div></header>
  <section class="drive-content <%= tab==='stats'?'stats-content':'' %>" id="dropZone">
  <% if(tab==='stats'){ %>
    <section class="stats-dashboard clean-stats" id="statsDashboard">
      <div class="stats-head">
        <div>
          <h1>Статистика</h1>
          <p>Живые просмотры, скачивания и расчёт дохода.</p>
        </div>
        <button class="stats-period" type="button">Последние 30 дней</button>
      </div>

      <div class="stats-kpis clean-kpis">
        <article>
          <small>Частота скачивания ⓘ</small>
          <b id="kpiRate"><%= statsPage.downloadRate.toFixed(2) %>%</b>
          <em>Скачивания / просмотры</em>
          <i id="kpiDownloads"><%= statsPage.downloads %> скач.</i>
        </article>
        <article>
          <small>С 1 000 просмотров ⓘ</small>
          <b id="kpiRpm">$<%= ((statsPage.views/1000)*0.1).toFixed(2) %></b>
          <em>$0.10 за 1000 просмотров</em>
          <i id="kpiViews"><%= statsPage.views %> просмотров</i>
        </article>
        <article>
          <small>С посетителя ⓘ</small>
          <b id="kpiVisitor">$<%= (statsPage.visitors ? ((statsPage.views/1000)*0.1)/statsPage.visitors : 0).toFixed(3) %></b>
          <em>Доход / посетители</em>
          <i id="kpiVisitors"><%= statsPage.visitors %> посет.</i>
        </article>
      </div>

      <section class="stats-card live-chart-card">
        <div class="stats-card-title">
          <div>
            <h2>Живой график активности</h2>
            <p>Линия обновляется автоматически без перезагрузки страницы.</p>
          </div>
          <div class="chart-legend">
            <span><i class="dot views"></i>Просмотры</span>
            <span><i class="dot downloads"></i>Скачивания</span>
          </div>
        </div>
        <div class="chart-wrap"><canvas id="statsLiveChart"></canvas></div>
      </section>
    </section>

  <% } else { %>
    <div class="files-toolbar">
      <div class="pathline">/ <%= currentFolder ? currentFolder.name : '' %></div>
      <div class="toolbar-actions">
        <input class="search" data-i18n-placeholder="search" placeholder="Поиск..." oninput="filterFiles(this.value)">
        <div class="sort-wrap"><button class="sortbtn" type="button" onclick="toggleSortMenu(event)"><span id="sortLabel" data-i18n="dateSort">По дате</span></button><div class="sort-menu" id="sortMenu"><button type="button" onclick="sortFiles('newest')">Сначала новые</button><button type="button" onclick="sortFiles('oldest')">Сначала старые</button></div></div>
        <button class="folderbtn" type="button" onclick="openFolderModal()" data-i18n="newFolder">Новая папка</button>
        <form action="/upload" method="post" enctype="multipart/form-data" class="upload-choice-wrap top-upload-wrap"><input type="hidden" name="folder_id" value="<%= folder || '' %>"><button class="top-upload upload-trigger" type="button" onclick="toggleUploadMenu(event,this)"><span data-i18n="upload">Загрузить файл</span></button><div class="upload-menu"><label class="upload-menu-item"><svg><use href="#i-upload"/></svg><span data-i18n="publicFile">Публичный файл</span><input name="file" type="file" data-visibility="public" onchange="startUploadAnimation(this,'public')"></label><label class="upload-menu-item"><svg><use href="#i-lock"/></svg><span data-i18n="privateFile">Приватный файл</span><input name="file" type="file" data-visibility="private" onchange="startUploadAnimation(this,'private')"></label></div></form>
      </div>
    </div>
    <% if(!currentFolder && folders.length){ %>
      <div class="folder-grid"><% folders.forEach(fd=>{ %>
        <a class="folder-card search-item" data-name="<%= fd.name.toLowerCase() %>" href="/dashboard?folder=<%= fd.id %>"><div class="folder-icon"><svg><use href="#i-folder"/></svg></div><b><%= fd.name %></b></a>
      <% }) %></div>
    <% } %>
    <% if(files.length===0 && (!folders.length || currentFolder)){ %>
      <div class="drive-empty">
        <div class="empty-visual">
          <img class="empty-gif" src="/assets/duck.gif" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
          <div class="empty-ill fallback-duck" style="display:none"><div class="cloud"></div><div class="duck-dot"></div><svg><use href="#i-file"/></svg></div>
        </div>
        <h2 data-i18n="noFiles">Пока нет файлов</h2>
        <p data-i18n="noFilesSub">Загрузите свой первый файл или перетащите<br>его прямо сюда</p>
        <div class="empty-actions">
          <form action="/upload" method="post" enctype="multipart/form-data" class="upload-choice-wrap empty-upload-wrap"><input type="hidden" name="folder_id" value="<%= folder || '' %>"><button class="empty-upload upload-trigger" type="button" onclick="toggleUploadMenu(event,this)"><span data-i18n="upload">Загрузить файл</span></button><div class="upload-menu"><label class="upload-menu-item"><svg><use href="#i-upload"/></svg><span data-i18n="publicFile">Публичный файл</span><input name="file" type="file" data-visibility="public" onchange="startUploadAnimation(this,'public')"></label><label class="upload-menu-item"><svg><use href="#i-lock"/></svg><span data-i18n="privateFile">Приватный файл</span><input name="file" type="file" data-visibility="private" onchange="startUploadAnimation(this,'private')"></label></div></form>
          <button class="empty-folder" type="button" onclick="openFolderModal()" data-i18n="newFolder">Новая папка</button>
        </div>
      </div>
    <% } else if(files.length){ %>
      <div class="selection-toolbar" id="selectionToolbar" aria-hidden="true">
        <div class="selection-count"><b id="selectedCount">0</b> <span data-i18n="selected">выбрано</span></div>
        <button class="bulk-btn" type="button" onclick="selectAllFiles()" data-i18n="selectAll">Выбрать все</button>
        <button class="bulk-btn" type="button" onclick="clearSelection()" data-i18n="clearSelection">Снять</button>
        <form id="bulkMoveForm" method="post" action="/batch/move" class="bulk-move-form">
          <input type="hidden" name="ids" id="bulkMoveIds">
          <select name="folder_id" id="bulkFolderSelect">
            <option value="" data-i18n="rootFolder">В корень</option>
            <% folders.forEach(fd=>{ %><option value="<%= fd.id %>"><%= fd.name %></option><% }) %>
          </select>
          <button class="bulk-btn" type="button" onclick="submitBulkMove()" data-i18n="moveSelected">Переместить</button>
        </form>
        <button class="bulk-btn danger" type="button" onclick="submitBulkDelete()"><svg><use href="#i-trash"/></svg><span data-i18n="deleteSelected">Удалить</span></button>
        <form id="bulkDeleteForm" method="post" action="/batch/delete"><input type="hidden" name="ids" id="bulkDeleteIds"></form>
      </div>
      <div class="drive-grid" id="files"><% files.forEach((f,idx)=>{ %>
        <article class="file-card search-item <%= f.is_private ? 'private' : '' %>" data-id="<%= f.id %>" data-index="<%= idx %>" data-date="<%= f.created_at || (f.expires_at - 3600000) %>" data-name="<%= f.original_name.toLowerCase() %>" onclick="openDetails(Number(this.dataset.index))">
          <label class="select-file" onclick="event.stopPropagation()" title="Выбрать файл"><input type="checkbox" value="<%= f.id %>" onchange="updateSelection()"><span></span></label>
          <div class="file-icon"><svg><use href="<%= f.is_private ? '#i-lock' : '#i-file' %>"/></svg></div>
          <div class="file-meta"><b title="<%= f.original_name %>"><%= f.original_name %></b><small><% if(f.is_private){ %><span class="private-chip">Private</span> <% } %><span class="meta-size"><%= fmt(f.size) %></span> <span class="sep">|</span> <span data-i18n="deleteIn">удалится через</span> <%= Math.max(0,Math.ceil((f.expires_at-now)/60000)) %> <span data-i18n="min">мин.</span></small></div><button class="file-dots" type="button" aria-label="Действия" onclick="openFileMenu(event,Number(this.closest('.file-card').dataset.index))">⋮</button>
        </article>
      <% }) %></div>
    <% } %>
  <% } %>
  </section>
</main>
<aside class="details-panel" id="detailsPanel"><button class="panel-close" type="button" onclick="closeDetails()">×</button><div id="detailsInner"></div></aside>
<nav class="mobile-bottom-nav" aria-label="Мобильная навигация">
  <a class="<%= tab==='files'?'active':'' %>" href="/dashboard"><svg><use href="#i-home"/></svg><span data-i18n="home">Главная</span></a>
  <a href="/dashboard"><svg><use href="#i-folder"/></svg><span data-i18n="files">Файлы</span><em><%= files.length + folders.length %></em></a>
  <a class="<%= tab==='stats'?'active':'' %>" href="/dashboard?tab=stats"><svg><use href="#i-stats"/></svg><span>Статистика</span></a>
  <button type="button" onclick="toggleMobileAccount()"><span class="mini-avatar"><%= (user.name||'U').slice(0,1).toLowerCase() %></span><span data-i18n="account">Аккаунт</span></button>
</nav>
<div class="mobile-drawer-backdrop" id="mobileDrawerBackdrop" onclick="closeMobileDrawer()"></div>
<form class="mobile-fab-upload" id="mobileFabUpload" action="/upload" method="post" enctype="multipart/form-data">
  <input type="hidden" name="folder_id" value="<%= folder || '' %>">
  <input id="mobileFabInput" name="file" type="file" data-visibility="public" onchange="startUploadAnimation(this,'public')">
  <button type="button" onclick="document.getElementById('mobileFabInput').click()" aria-label="Загрузить файл">+</button>
</form>
<div class="support-chat" id="supportChat">
  <div class="support-head"><button type="button" onclick="closeSupportChat()">‹</button><div class="support-head-info"><div class="support-title-line"><b>Turov Cloud</b><span class="support-online"><i></i>Онлайн</span></div><span class="support-subtitle">Обычно отвечаем в течение нескольких минут</span></div><button type="button" onclick="closeSupportChat()">×</button></div>
  <div class="support-messages" id="supportMessages"><div class="support-empty">Напишите вопрос — мы поможем.</div></div>
  <div class="support-drop-overlay" id="supportDropOverlay"><div class="support-drop-card"><div class="eye">👀</div><b>Перетащите файл сюда</b><span>Фото, архивы и документы прикрепятся к сообщению</span></div></div>
  <div class="support-file-chip" id="supportFileChip" style="display:none"></div>
  <form class="support-input" onsubmit="sendSupportMessage(event)">
    <input id="supportFile" name="file" type="file" onchange="showSupportFileName()" hidden>
    <button class="support-attach" type="button" onclick="document.getElementById('supportFile').click()" aria-label="Прикрепить файл">📎</button>
    <button class="support-ai-btn" id="supportAiBtn" type="button" onclick="askAiSupport()" aria-label="ИИ-помощник">✨</button>
    <input id="supportInput" name="message" autocomplete="off" maxlength="1200" placeholder="Введите сообщение">
    <button type="submit">➜</button>
  </form>
</div>
<aside class="mobile-drawer" id="mobileDrawer">
  <button class="drawer-close" onclick="closeMobileDrawer()">×</button>
  <a class="drive-brand drawer-brand" href="/dashboard"><span class="drive-logo asset-logo"><img src="/assets/logo.png" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='block'"><svg><use href="#i-logo"/></svg></span><span>Turov Cloud</span></a>
  <button class="drawer-item" onclick="toggleLang()"><svg><use href="#i-lang"/></svg><span data-i18n="language">Язык</span><b id="drawerLang">RU</b></button>
  <button class="drawer-item" onclick="toggleTheme()"><svg><use href="#i-moon"/></svg><span data-i18n="theme">Тема</span><b id="drawerTheme">dark</b></button>
  <button class="drawer-item" onclick="openFolderModal();closeMobileDrawer()"><svg><use href="#i-folder"/></svg><span data-i18n="newFolder">Новая папка</span></button>
  <button class="drawer-item" onclick="openSupportChat();closeMobileDrawer()"><span class="support-mini-icon">💬</span><span>Поддержка на сайте</span></button>
